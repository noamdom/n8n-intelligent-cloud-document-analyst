    {
      "parameters": {
        "jsCode": "const d = $json;\n\n// Handle action_items whether it's a string or array\nconst actionsRaw = d.action_items || '';\nconst actions = Array.isArray(actionsRaw) \n  ? actionsRaw \n  : actionsRaw.split(',').map(a => a.trim()).filter(a => a);\n\nconst markdown = `# Document Analysis Report \nFile Name: ${$input.first().json.filename}\nFile Type: ${$input.first().json[\"file type\"]}\n\n## Summary\n${d.summary}\n\n## Classification\n- **Type:** ${d.classification}\n- **Department:** ${d.department}\n- **Sentiment:** ${d.sentiment}\n- **Sensitivity:** ${d.sensitivity}\n- **Routing Tag:** ${d.routing_tag}\n- **Confidence:** ${d.confidence_score}\n\n## Action Items\n${actions.map(a => `- ${a}`).join('\\n')}\n\n---\n*Processed at ${d.processed_at} by n8n + Gemini Document Analyst*\n`;\n\nreturn [{ json: { ...d, markdown_content: markdown } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [2368, -368],
      "id": "af7aae1f-0016-4b74-b83d-5301788d0125",
      "name": "Convert to MD"
    },
    {
      "parameters": {
        "jsCode": "const extracted = $json;\nconst text = extracted.text || '';\nconst images = extracted.images || [];\n\nconst parts = [\n  {\n    text: `You are a document intelligence assistant. Analyze the following document and return ONLY a valid JSON object with these exact fields:\n\n{\n  \"summary\": \"2-3 sentence summary\",\n  \"classification\": \"one of: [invoice, report, contract, ticket, article, product-review ,other]\",\n  \"sentiment\": \"one of: [positive, neutral, negative]\",\n  \"entities\": {\n    \"people\": [], \"organizations\": [], \"dates\": [], \"amounts\": []\n  },\n  \"action_items\": [\"list of recommended actions\"],\n  \"confidence_score\": 0.0\n}\n\nDocument text:\n${text}`\n  }\n];\n\n// Add each image as an inlineData part\nfor (const img of images) {\n  parts.push({\n    inlineData: {\n      mimeType: img.mime_type,\n      data: img.base64\n    }\n  });\n}\n\nreturn [{\n  json: {\n    gemini_payload: {\n      contents: [{ parts }],\n      generationConfig: {\n        temperature: 0.2,\n        responseMimeType: \"application/json\"\n      }\n    }\n  }\n}];"
      },
