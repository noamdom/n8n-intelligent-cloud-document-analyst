    {
      "parameters": {
        "jsCode": "const items = $input.all();\n\nreturn items.map(item => {\n  try {\n    // 1. Access the data structure\n    // Sometimes n8n passes it as an array inside item.json, sometimes directly as the object\n    const data = Array.isArray(item.json) ? item.json[0] : item.json;\n    \n    // Extract the raw text from the Gemini response\n    const rawText = data.content.parts[0].text;\n    \n    // 2. Strip the markdown formatting (```json and ```)\n    const cleanJsonString = rawText\n      .replace(/```json/gi, '') // Remove opening tag\n      .replace(/```/g, '')      // Remove closing tag\n      .trim();                  // Remove extra whitespace/newlines\n    \n    // 3. Parse the cleaned string back into a real JSON object\n    const parsedData = JSON.parse(cleanJsonString);\n    \n    // 4. Return it formatted for the next n8n node\n    return { json: parsedData };\n    \n  } catch (error) {\n    // Useful for debugging if Gemini returns something unexpected\n    throw new Error(`Failed to parse Gemini output: ${error.message}`);\n  }\n});\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1472, -176],
      "id": "29fd5fce-5091-4c3a-9b9e-6597dad72387",
      "name": "Convert Gemini response to JSON"
    },
    {
      "parameters": {
        "jsCode": "const data = $input.first().json;\n\nconst rawText = data.candidates[0].content.parts[0].text;\n\n// Reformat to match the n8n Gemini node structure\n// so the existing parse node works unchanged\nreturn [{\n  json: {\n    content: {\n      parts: [{ text: rawText }]\n    }\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
